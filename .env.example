# ============================================================
# Variáveis de ambiente — EstoQ
# ============================================================
# Copie para .env e preencha. NUNCA commite o .env.
# Arquivo de referência: cada serviço usa apenas suas variáveis.
# ============================================================

# --- Backend (Render) ---
DATABASE_URL=jdbc:postgresql://ep-xxx-xxx-123456.us-east-2.aws.neon.tech/estoq_startup?currentSchema=estoq_v2
DATABASE_USER=neondb_owner
DATABASE_PASSWORD=AAABBBCCCDDD
PORT=8080
SESSION_SECURE=true
SESSION_SAMESITE=lax
DDL_AUTO=update
SEED_ENABLED=false
CORS_ORIGINS=
API_DOCS_ENABLED=false
ESTOQ_BACKUP_DIR=/tmp/estoq-backups
ESTOQ_BACKUP_HOST=ep-xxx-xxx-123456.us-east-2.aws.neon.tech
ESTOQ_BACKUP_PORTA=5432
ESTOQ_BACKUP_DB=estoq_startup
ESTOQ_BACKUP_SCHEMA=estoq_v2
ESTOQ_BACKUP_USER=neondb_owner
ESTOQ_BACKUP_PASS=AAABBBCCCDDD
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_MINUTOS=15

# --- Frontend (Vercel) ---
RENDER_BACKEND_URL=https://estoq-backend.onrender.com
