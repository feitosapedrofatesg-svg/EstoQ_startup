# ============================================================
# Variáveis de ambiente — EstoQ
# ============================================================
# Copie para .env e preencha. NUNCA commite o .env.
# Arquivo de referência: cada serviço usa apenas suas variáveis.
# ============================================================

# --- Backend (Render) ---
# Supabase: copiar host/porta/username em Connect > Session pooler.
# Não usar a URL HTTPS do projeto nem a porta 6543 (Transaction pooler).
DATABASE_URL=jdbc:postgresql://HOST_DO_SESSION_POOLER:5432/postgres?sslmode=require&currentSchema=estoq_v2
DATABASE_USER=postgres.REFERENCIA_DO_PROJETO
DATABASE_PASSWORD=PREENCHA_NO_AMBIENTE_PRIVADO
SPRING_PROFILES_ACTIVE=prod
PORT=8080
SESSION_SECURE=true
SESSION_SAMESITE=lax
DDL_AUTO=validate
FLYWAY_ENABLED=true
SEED_ENABLED=false
CORS_ORIGINS=
API_DOCS_ENABLED=false
ESTOQ_BACKUP_DIR=/tmp/estoq-backups
# Vazios: herdar conexão do datasource. Remover overrides antigos no Render.
ESTOQ_BACKUP_HOST=
ESTOQ_BACKUP_PORTA=0
ESTOQ_BACKUP_DB=
ESTOQ_BACKUP_SCHEMA=estoq_v2
ESTOQ_BACKUP_USER=
ESTOQ_BACKUP_PASS=
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_MINUTOS=15

# --- Frontend (Vercel) ---
RENDER_BACKEND_URL=https://estoq-backend-va.onrender.com

# --- Confirmação de e-mail (backend) ---
# Autorizar e testar antes de ativar; veja apis/google/README.md.
EMAIL_CONFIRMACAO_ENABLED=false
EMAIL_FROM=estoq.sistema@gmail.com
APP_PUBLIC_URL=https://estoq-oficial.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Entrar com Google (backend, cliente OAuth Aplicativo da Web) ---
# Cliente distinto do Gmail Desktop e próprio de cada ambiente.
# Compartilha APP_PUBLIC_URL com a confirmação acima.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
