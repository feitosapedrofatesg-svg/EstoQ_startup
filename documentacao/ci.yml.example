name: Validação

on:
  push:
    branches: [dev, homologacao, main]
  pull_request:
    branches: [dev, homologacao, main]

permissions:
  contents: read

jobs:
  backend:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - name: Validar proteções da limpeza administrativa
        run: python3 -m unittest discover -s scripts/tests -v
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
          cache: maven
          cache-dependency-path: backend/pom.xml
      - name: Instalar OCR para testes com documentos fictícios
        run: sudo apt-get update && sudo apt-get install -y tesseract-ocr tesseract-ocr-por
      - run: mvn -B test -Dnotas.ocr.executavel=/usr/bin/tesseract
        working-directory: backend
      - name: Listar dependências de produção resolvidas
        run: mvn -B dependency:list -DincludeScope=runtime -DoutputFile=target/dependencias.txt
        working-directory: backend
      - name: Consultar avisos de segurança no OSV
        run: python3 scripts/verificar_dependencias.py backend/target/dependencias.txt
  frontend:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: npm
          cache-dependency-path: frontend/package-lock.json
      - run: npm ci
        working-directory: frontend
      - run: npm audit --audit-level=high
        working-directory: frontend
      - run: npm run test:infra
        working-directory: frontend
      - run: npm run build
        working-directory: frontend
      - run: npx playwright install --with-deps chromium
        working-directory: frontend
      - run: npm test
        working-directory: frontend
